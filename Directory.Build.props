<Project>
  <!-- The game's BepInEx folder. Change it if Steam is installed elsewhere,
       or on the command line: dotnet build -p:BepInExDir="D:\...\Idle Slayer\BepInEx" -->
  <PropertyGroup>
    <BepInExDir Condition="'$(BepInExDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Idle Slayer\BepInEx</BepInExDir>
  </PropertyGroup>
</Project>
